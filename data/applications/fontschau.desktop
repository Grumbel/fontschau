[Desktop Entry]
Type=Application
Name=Fontschau
GenericName=Font Viewer
Comment=Browse and preview installed fonts
Exec=fontschau %f
Icon=fontschau
Terminal=false
Categories=Utility;Graphics;Viewer;
Keywords=font;typeface;typography;preview;
StartupNotify=true
MimeType=font/ttf;font/otf;font/collection;
